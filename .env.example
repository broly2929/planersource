# API
DATABASE_URL=postgres://planer:planer@localhost:5432/planersource
PORT=3000
SESSION_SECRET=changez-moi-au-moins-32-caracteres-aleatoires
NODE_ENV=development
# Compte de développement admin / admin : créé si NODE_ENV=development et base vide. Mettre 0 pour le désactiver.
# DEV_ADMIN=0

# Tests : base dédiée, le nom DOIT finir par _test (jamais la base planersource)
TEST_DATABASE_URL=postgres://planer_test:planer_test@localhost:5432/planersource_test

# Web (dev) : le proxy Vite redirige /api vers cette URL
VITE_API_URL=http://localhost:3000
