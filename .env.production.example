# Configuration de production (Docker, D-138 (3)). Copier ce fichier en .env, puis changer les valeurs « À CHANGER ».

# Base de données (service db)
POSTGRES_DB=planersource
POSTGRES_USER=planersource
# À CHANGER : mot de passe de la base. Lettres et chiffres seulement (il entre dans une URL).
POSTGRES_PASSWORD=changezmoi

# À CHANGER : secret des cookies de session, au moins 32 caractères aléatoires (par exemple : openssl rand -hex 32).
SESSION_SECRET=changez-moi-au-moins-32-caracteres-aleatoires

# Port de l'application sur la machine hôte.
PORT=8080

# Cookie de session « secure » : 0 permet l'accès en HTTP simple (premier accès, réseau local).
# Mettre 1 derrière HTTPS (reverse proxy).
COOKIE_SECURE=0

# Adresse IP des clients pour la limitation des tentatives de connexion : 1 derrière un reverse proxy
# (lue dans X-Forwarded-For), 0 sans proxy.
TRUST_PROXY=0

# Compte initial admin / admin, créé au démarrage si la base est vide. Mettre 0 pour ne pas le créer.
# INITIAL_ADMIN=0
